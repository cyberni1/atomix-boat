{
 "cleanUrls": true,
 "rewrites": [
  {
   "source": "/extras",
   "destination": "/"
  },
  {
   "source": "/705ht",
   "destination": "/"
  }
 ],
 "headers": [
  {
   "source": "/assets/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/(app.js|app.css)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=0, must-revalidate"
    }
   ]
  },
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    }
   ]
  }
 ]
}